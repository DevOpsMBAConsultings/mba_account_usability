<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="account" position="attributes">
                <attribute name="string">Accounting</attribute>
            </app>
            <block id="accounting_reports">
                <setting id="fiscalyear_last_day" string="Fiscal Year Last Day">
                    <field name="fiscalyear_last_day" class="oe_inline" />
                    <field name="fiscalyear_last_month" />
                </setting>
                <setting id="fiscalyear_last_month" />
            </block>
        </field>
    </record>
</odoo>
